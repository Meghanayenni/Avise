# Copy to .env and adjust. Never commit .env.
AVISE_ENVIRONMENT=dev
AVISE_LOG_LEVEL=INFO

AVISE_DATABASE_URL=postgresql+psycopg://avise:avise@localhost:5432/avise
AVISE_TEST_DATABASE_URL=postgresql+psycopg://avise:avise@localhost:5432/avise_test

# Locked to the Vite dev origin
AVISE_CORS_ORIGIN=http://localhost:5173

# Secure cookies work on http://localhost and http://127.0.0.1.
# They are NOT sent over a LAN IP such as http://192.168.x.x — see README.
AVISE_SESSION_COOKIE_SECURE=true

AVISE_UPLOAD_DIR=./uploads
AVISE_MAX_UPLOAD_MB=25
